{
  "name": "porra-birreros-f1",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "build:css": "npx @tailwindcss/cli -i ./src.css -o ./dist/styles.css --minify",
    "build:js": "npx esbuild app.jsx --bundle --minify --sourcemap --target=es2020 --format=iife --global-name=PorraApp --outfile=dist/app.js --define:process.env.NODE_ENV=\\\"production\\\" --loader:.jsx=jsx --jsx=automatic",
    "preview": "npx serve dist"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
